---
import { type CollectionEntry, getCollection } from "astro:content";

interface Props {
  series: string | undefined;
  title: string;
}

const { series, title } = Astro.props;

const posts = await getCollection("blog");

const getPostPath = (post: CollectionEntry<"blog"> | null) => {
  if (!post) return null;

  const path = post.id
    .slice(0, post.id.lastIndexOf("/"))
    .toLowerCase();
  return "/post/" + path + "/";
};

const isSeries = Boolean(series && series.trim().length > 0);
let seriesDir: string | null = null;
let previousPost: CollectionEntry<"blog"> | null = null;
let nextPost: CollectionEntry<"blog"> | null = null;

if (isSeries) {
  const filteredPosts = posts
    .filter((post) => post.data.series === series)
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  if (filteredPosts.length > 0) {
    const segments = filteredPosts[0].id.split('/');
    // 取倒數第 3 個 segment 作為系列目錄名 (例: software/series/build-automated-deploy/xxx/index.md)
    seriesDir = segments.length >= 3 ? segments[segments.length - 3].toLowerCase() : null;
  }

  const currentIndex = filteredPosts.findIndex(
    (post) => post.data.title === title
  );

  previousPost = currentIndex > 0 ? filteredPosts[currentIndex - 1] : null;
  nextPost =
    currentIndex >= 0 && currentIndex < filteredPosts.length - 1
      ? filteredPosts[currentIndex + 1]
      : null;
} else {
  // 獨立文章：依發布日期由舊到新排序，提供按時序閱讀的前後文章導航
  const sortedPosts = posts
    .slice()
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  const currentIndex = sortedPosts.findIndex(
    (post) => post.data.title === title
  );

  previousPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
  nextPost =
    currentIndex >= 0 && currentIndex < sortedPosts.length - 1
      ? sortedPosts[currentIndex + 1]
      : null;
}
---

<nav class="article-nav" aria-label={isSeries ? `系列導航：${series}` : "相關文章導航"}>
  <hr class="nav-divider" />
  <div class="nav-header">
    {isSeries ? (
      <a class="series-link" href={seriesDir ? `/series/${seriesDir}/` : '/series/'}>
        <div class="series-badge">SERIES · 系列專題</div>
        <div class="series-title">{series}</div>
      </a>
    ) : (
      <div class="standalone-header">
        <div class="series-badge">POST NAVIGATION · 文章導航</div>
      </div>
    )}
  </div>

  <div class="nav-grid">
    {previousPost ? (
      <a class="nav-card prev-card" rel="prev" href={getPostPath(previousPost)}>
        <span class="nav-direction">← {isSeries ? "系列上一篇" : "上一篇"}</span>
        <span class="nav-title">{previousPost.data.title}</span>
      </a>
    ) : (
      <div class="nav-spacer" aria-hidden="true" />
    )}

    {nextPost ? (
      <a class="nav-card next-card" rel="next" href={getPostPath(nextPost)}>
        <span class="nav-direction">{isSeries ? "系列下一篇" : "下一篇"} →</span>
        <span class="nav-title">{nextPost.data.title}</span>
      </a>
    ) : (
      <div class="nav-spacer" aria-hidden="true" />
    )}
  </div>
</nav>

<style>
  .article-nav {
    margin: var(--spacing-2xl) 0 var(--spacing-xl);
  }

  .nav-divider {
    border: 0;
    border-top: 1px solid var(--color-border-light);
    margin: 0 0 var(--spacing-xl);
  }

  .nav-header {
    margin-bottom: var(--spacing-md);
  }

  .series-link {
    display: inline-block;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .series-link:hover .series-title {
    color: var(--color-primary);
  }

  .series-badge {
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    letter-spacing: 0.08em;
    margin-bottom: var(--spacing-xs);
  }

  .series-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    line-height: var(--line-height-tight);
    transition: color var(--transition-normal);
  }

  .nav-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-normal), transform var(--transition-normal), background-color var(--transition-normal);
  }

  .nav-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    background-color: var(--color-bg-muted);
  }

  .nav-direction {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-xs);
  }

  .next-card {
    text-align: right;
  }

  .next-card .nav-direction {
    align-self: flex-end;
  }

  .nav-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
    line-height: var(--line-height-normal);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .nav-spacer {
    display: none;
  }

  @media (min-width: 641px) {
    .nav-spacer {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .nav-grid {
      grid-template-columns: 1fr;
    }

    .next-card {
      text-align: left;
    }

    .next-card .nav-direction {
      align-self: flex-start;
    }
  }
</style>
