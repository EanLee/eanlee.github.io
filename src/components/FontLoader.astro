---
// 簡化的字體載入組件
---

<script>
  function markFontsLoaded() {
    (document as any).documentElement.classList.add('font-loaded');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', markFontsLoaded);
  } else {
    markFontsLoaded();
  }

  document.addEventListener('astro:page-load', markFontsLoaded);
</script>

<style>
  /* 字體載入完成後應用 */
  html.font-loaded {
    font-family: var(--font-family-primary);
  }
</style>