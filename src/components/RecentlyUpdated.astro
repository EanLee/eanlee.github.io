---
import FormattedDate from "./FormattedDate.astro";
import SectionHeader from "./SectionHeader.astro";
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  limit?: number;
  thresholdDays?: number;
}

const { posts, limit = 6, thresholdDays = 30 } = Astro.props;

const MS_PER_DAY = 1000 * 60 * 60 * 24;

// 只挑「lastmod 明顯晚於 date」的文章，代表發布後曾被回頭大幅修訂
const updatedPosts = posts
  .filter((post) => {
    const { date, lastmod } = post.data;
    if (!lastmod) return false;
    return (lastmod.valueOf() - date.valueOf()) / MS_PER_DAY > thresholdDays;
  })
  .sort((a, b) => b.data.lastmod!.valueOf() - a.data.lastmod!.valueOf())
  .slice(0, limit);
---

{updatedPosts.length > 0 && (
  <div class="recently-updated">
    <SectionHeader title="近期更新">
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
        <path d="M21 3v5h-5"/>
        <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
        <path d="M3 21v-5h5"/>
      </svg>
    </SectionHeader>

    <div class="updated-list">
      {updatedPosts.map((post) => {
        const path = post.id.slice(0, post.id.lastIndexOf("/")).toLowerCase();
        return (
          <article class="updated-item">
            <a href={`/post/${path}/`} class="updated-link">
              <div class="updated-header">
                <span class="updated-badge">已更新</span>
                <h3 class="updated-title">{post.data.title}</h3>
              </div>
              {post.data.description && (
                <p class="updated-excerpt">{post.data.description}</p>
              )}
              <div class="updated-meta">
                <span class="meta-item">
                  發布於 <FormattedDate date={post.data.date} />
                </span>
                <span class="meta-item">
                  更新於 <FormattedDate date={post.data.lastmod!} />
                </span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
)}

<style>
  .recently-updated {
    margin-bottom: var(--spacing-2xl);
  }

  .updated-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-lg);
  }

  .updated-item {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-normal);
  }

  .updated-item:hover {
    border-color: var(--color-primary);
  }

  .updated-link {
    display: block;
    padding: var(--spacing-md) var(--spacing-lg);
    text-decoration: none;
  }

  .updated-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .updated-badge {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-warning, #d97706);
    background-color: var(--color-warning-bg, rgba(217, 119, 6, 0.12));
    padding: 2px var(--spacing-sm);
    border-radius: var(--radius-full);
  }

  .updated-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: var(--text-primary);
  }

  .updated-link:hover .updated-title {
    color: var(--color-primary);
  }

  .updated-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: var(--spacing-xs) 0 var(--spacing-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .updated-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .updated-list {
      grid-template-columns: 1fr;
    }
  }
</style>
